PROJECT_NAME="Consistency Analyzer"
FRONTEND_HOST=http://localhost:5173

# External PostgreSQL with the pgvector extension enabled
DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app
# TEST_DATABASE_URL=postgresql://postgres:changethis@localhost:5432/app_test

# Chat model (OpenAI-compatible; DeepSeek by default)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Embedding service (OpenAI-compatible /embeddings)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
